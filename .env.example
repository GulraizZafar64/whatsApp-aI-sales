# ── Required ─────────────────────────────────────────────────────────────

# MySQL (use DATABASE_URL or the DB_* variables below)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/whatsapp_sales

# Sign-in JWT (generate a long random string, e.g. openssl rand -base64 32)
JWT_SECRET=

# Admin panel (/admin) — separate from customer accounts
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=choose-a-strong-password
# Optional API secret for scripts (Bearer or x-admin-secret header)
# ADMIN_SECRET=

# Claude — AI WhatsApp replies
ANTHROPIC_API_KEY=

# WhatsApp session storage (LocalAuth profiles — keep across restarts; do NOT delete on deploy)
# Default: <project>/.wwebjs_auth
# WWEBJS_AUTH_PATH=D:/Whatsauto/whatsApp-aI-sales/.wwebjs_auth

# ── Optional ───────────────────────────────────────────────────────────

# Voice note transcription (OpenAI Whisper)
# OPENAI_API_KEY=

# SQL logging: SEQUELIZE_LOGGING=1

# Bargain follow-up delay in minutes (default 30)
# WHATSAPP_FOLLOW_UP_MINUTES=30

# Protect cron route GET /api/cron/whatsapp-followups
# CRON_SECRET=

# Order notification emails to business owners
# Minimum setup (host/port inferred from your email domain — Gmail, Outlook, etc.):
# SMTP_EMAIL=you@gmail.com
# SMTP_PASS=your-app-password-or-smtp-password
#
# Optional overrides (custom SMTP / non-standard provider):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_FROM="WhatsApp Sales <you@gmail.com>"

# Public HTTPS URL — REQUIRED for checkout (Whop webhook URL alone is not enough).
# Use the same ngrok host as Whop webhook, without /api/billing/whop-webhook
# APP_URL=https://your-subdomain.ngrok-free.app
# NGROK_URL=https://your-subdomain.ngrok-free.app

# Whop billing
# WHOP_ENV=development
# WHOP_SANDBOX_CHECKOUT_URL_STARTER=
# WHOP_SANDBOX_CHECKOUT_URL_PRO=
# WHOP_LIVE_CHECKOUT_URL_STARTER=
# WHOP_LIVE_CHECKOUT_URL_PRO=
# WHOP_API_KEY=
# WHOP_WEBHOOK_SECRET=
# Webhook URL in Whop dashboard: https://your-domain.com/api/billing/whop-webhook
# Events: payment.succeeded, payment.failed, membership.activated, membership.deactivated
