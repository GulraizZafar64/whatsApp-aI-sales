# MySQL (choose DATABASE_URL or individual variables)
# Example: mysql://user:password@127.0.0.1:3306/whatsapp_sales
DATABASE_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=whatsapp_sales
# DB_USER=root
# DB_PASSWORD=

# Set to 1 to log SQL from Sequelize
# SEQUELIZE_LOGGING=1

# Optional legacy webhook verify (used only if Meta Console still has this value).
# Per-business verify tokens are saved in DB at connect — prefer those in Meta Console.
# WHATSAPP_VERIFY_TOKEN=

# Meta app (sign-in / connect API — exchanges user token and saves per business in DB)
# Prefer FACEBOOK_APP_ID / FACEBOOK_APP_SECRET; NEXT_PUBLIC_META_APP_ID / META_APP_SECRET also work.
# App Review scopes requested at login: whatsapp_business_management, whatsapp_business_messaging,
# whatsapp_business_manage_events, manage_app_solution, public_profile.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
# If login returns a valid token but "No WABA found", link a WhatsApp Business Account in
# Meta Developer Console → your app → WhatsApp → API Setup, then sign in again.
# WhatsApp Cloud API credentials are NOT stored in .env.
# On Sign in / Get started, Meta returns a token; the app saves each phone_number_id,
# whatsapp_token, and webhook_verify_token in `businesses`. Webhook GET verification and
# AI sends use those DB values (not .env). Copy webhook_verify_token from the dashboard
# profile API into Meta → WhatsApp → Configuration → Verify token.

# Public HTTPS base URL Meta can call (no trailing slash). Use your ngrok URL in dev, e.g.
# https://abcd-12-34-56-78.ngrok-free.app
# Webhook in Meta: NEXT_PUBLIC_APP_URL + /api/whatsapp/webhook
NEXT_PUBLIC_APP_URL=

# Anthropic Claude — used for WhatsApp webhook auto-replies when no key is saved
# on the business in the dashboard. Also accepts CLAUDE_API_KEY.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI Whisper — transcribes customer voice notes (Urdu, Hindi, English, Japanese, Chinese, etc.)
# Auto-detects language; no language code needed. Alias: WHISPER_API_KEY
OPENAI_API_KEY=

# Minutes of silence before a bargain-price follow-up WhatsApp (default 30)
# WHATSAPP_FOLLOW_UP_MINUTES=30

# Optional: protect GET /api/cron/whatsapp-followups (Bearer token or ?secret=)
# CRON_SECRET=

# Admin: fix or check WABA webhook subscriptions for all businesses in DB
# POST /api/admin/fix-all-subscriptions
# GET  /api/admin/check-subscriptions
# Header: Authorization: Bearer <ADMIN_SECRET>  or  x-admin-secret: <ADMIN_SECRET>
# ADMIN_SECRET=

